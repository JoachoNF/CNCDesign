# ============================================================================
# CNCDesign — Variables de entorno para el router multi-IA
#
# Copia este archivo a .env y rellena lo que vayas a usar.
# Las claves también pueden configurarse desde la app (⚙ Configuración IA);
# lo guardado en config-ia.json tiene PRIORIDAD sobre estas variables.
# ============================================================================

# Anthropic (Claude — creación general e image-to-CAD)
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# OpenAI (GPT — edición / create-and-edit)
OPENAI_API_KEY=sk-proj-tu_clave_aqui

# Groq (API gratuita, OpenAI-compatible — Llama en la nube). Sin costo de uso.
GROQ_API_KEY=gsk_tu_clave_gratuita_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (API gratuita con API key — tier free)
GEMINI_API_KEY=AIza_tu_clave_gratuita_aqui
GEMINI_MODEL=gemini-3.8-flash

# Mistral (API gratuita, OpenAI-compatible — modelos open weights)
MISTRAL_API_KEY=...tu_clave_mistral_aqui
MISTRAL_MODEL=mistral-small-latest

# OpenRouter (gateway multi-modelo — opciones free con sufijo :free)
OPENROUTER_API_KEY=sk-or-tu_clave_aqui
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama local (fallback gratuito, sin costo)
OLLAMA_URL=http://localhost:11434
# Modelo por defecto si no se elige otro en el selector de la app:
OLLAMA_MODEL=qwen2.5-coder:7b

# Entorno
NODE_ENV=development
