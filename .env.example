# ============================================================================
# CNCDesign — Variables de entorno para el router multi-IA
#
# Copia este archivo a .env y rellena lo que vayas a usar.
# Las claves también pueden configurarse desde la app (⚙ Configuración IA);
# lo guardado en config-ia.json tiene PRIORIDAD sobre estas variables.
# ============================================================================

# Anthropic (Claude — creación general e image-to-CAD)
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# OpenAI (GPT — edición / create-and-edit)
OPENAI_API_KEY=sk-proj-tu_clave_aqui

# Ollama local (fallback gratuito, sin costo)
OLLAMA_URL=http://localhost:11434
# Modelo por defecto si no se elige otro en el selector de la app:
OLLAMA_MODEL=qwen2.5-coder:7b

# Entorno
NODE_ENV=development
