{
  "name": "cnc-design",
  "productName": "CNCDesign",
  "version": "1.0.0",
  "description": "Entorno multi-agente para diseño 3D y automatización de pedidos .dxf para CNC",
  "main": "dist/electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "predev": "tsc -p tsconfig.build.json",
    "dev": "concurrently \"NODE_ENV=development vite\" \"NODE_ENV=development electron . --no-sandbox --disable-gpu\"",
    "build": "vite build && tsc -p tsconfig.build.json && electron-builder",
    "start": "electron dist/electron/main.js --no-sandbox --disable-gpu",
    "preview": "vite preview",
    "electron": "electron .",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dxf-render": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.0",
    "three": "^0.170.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.56.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.0.0",
    "vite": "^5.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
